{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lines-scribe",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "https://lines.adcatheatre.com",
    "DAILY_CLASS_SECONDS": "36000",
    "DAILY_DEVICE_SECONDS": "3600"
  },
  "account_id": "1036fbb4f942d8029b247268f3752245",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lines-usage",
      "database_id": "34f14264-2094-4ed4-b433-640150a514a9"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
