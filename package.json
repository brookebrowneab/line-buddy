{
  "name": "line-buddy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "script": "node scripts/build-script.mjs",
    "build": "node scripts/prepare-local-stt.mjs && node scripts/build-script.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "audio:plan": "node scripts/build-script.mjs && node scripts/generate-audio.mjs",
    "audio:generate": "node --env-file=.env scripts/generate-audio.mjs --generate",
    "predev": "node scripts/prepare-local-stt.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
